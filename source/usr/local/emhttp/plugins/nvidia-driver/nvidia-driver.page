<script>
function changeVersion(form) {
    var package = form.drv_version.value;
    openBox("/usr/local/emhttp/plugins/nvidia-driver/include/exec.sh&arg1=update_version&arg2="+package,"正在下载驱动包",600,800,true);
    return false;
    }

function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
}

function gpuSupportLabel(value) {
    var labels = {
      'proprietary-only': '仅支持专有内核模块',
      'both': '支持开源和专有内核模块',
      'open-only': '仅支持开源内核模块',
      'unknown': '未知',
      'best-available': '当前可用的最高版本',
      'open-source': '开源内核驱动',
      'production-branch': '生产分支',
      'no-supportedchips-pages-fetched': '无法获取 NVIDIA 显卡支持列表，请检查网络后重试',
      'device-id-not-listed-in-checked-versions': '已检查的驱动版本均未列出此设备 ID'
    };
    return Object.prototype.hasOwnProperty.call(labels, value) ? labels[value] : value;
}

var latestGpuSupportRows = [];
var gpuSelectionFilterDisabled = false;

function resetDriverOptionSupport() {
    var options = document.querySelectorAll('input[name="drv_version"]');
    options.forEach(function(option) {
      option.disabled = false;
      var parent = option.closest('p');
      if (parent) {
        parent.style.opacity = '1';
        parent.style.display = '';
      }
    });
}

function updateGpuFilterButton() {
    var button = document.getElementById('toggle-gpu-driver-filter');
    var status = document.getElementById('gpu-driver-filter-status');
    if (!button || !status) {
      return;
    }

    if (gpuSelectionFilterDisabled) {
      button.value = '启用 GPU 兼容性筛选';
      status.textContent = '已停用 GPU 兼容性筛选。';
    } else {
      button.value = '停用 GPU 兼容性筛选';
      status.textContent = '已启用 GPU 兼容性筛选。';
    }
}

function toggleGpuDriverFilter() {
    gpuSelectionFilterDisabled = !gpuSelectionFilterDisabled;

    if (gpuSelectionFilterDisabled) {
      resetDriverOptionSupport();
    } else {
      applyDriverOptionSupport(latestGpuSupportRows);
    }

    updateGpuFilterButton();
}

function renderGpuSupportRows(rows) {
    var container = document.getElementById('gpu-support-content');
    if (!container) {
      return;
    }

    if (!Array.isArray(rows) || rows.length === 0) {
      container.innerHTML = '<p><i>暂无 GPU 兼容性数据（GPU 查询失败或未检测到设备）。</i></p>';
      return;
    }

    var html = '';
    rows.forEach(function(row) {
      html += '<p>';
      html += '<b>' + escapeHtml(row.gpu_index + ': ' + row.gpu_name) + '</b><br/>';
      if (row.detection_source) {
        html += '检测方式： <code>' + escapeHtml(row.detection_source) + '</code><br/>';
      }
      if (row.chip_codename) {
        html += '芯片代号： <code>' + escapeHtml(row.chip_codename) + '</code><br/>';
      }
      if (row.architecture) {
        html += '架构： <code>' + escapeHtml(row.architecture) + '</code><br/>';
      }
      if (row.kernel_module_support) {
        html += '内核模块支持： <b>' + escapeHtml(gpuSupportLabel(row.kernel_module_support)) + '</b><br/>';
      }
      html += '原始设备 ID： <code>' + escapeHtml(row.gpu_input_device_id || '') + '</code><br/>';
      html += '标准设备 ID： <code>' + escapeHtml(row.device_id || '') + '</code><br/>';

      if (Array.isArray(row.valid_drivers) && row.valid_drivers.length > 0) {
        html += '兼容的候选驱动： <b style="color:green">' + escapeHtml(row.valid_drivers.join(', ')) + '</b><br/>';
        html += '推荐驱动： <b style="color:green">' + escapeHtml(row.recommended_driver || '') + '</b>';
        if (row.recommendation_source) {
          html += ' <i>(' + escapeHtml(gpuSupportLabel(row.recommendation_source)) + ')</i>';
        }
      } else {
        html += '兼容的候选驱动： <b style="color:tomato">无</b><br/>';
        html += '原因： <i>' + escapeHtml(gpuSupportLabel(row.no_match_reason || 'unknown')) + '</i>';
      }

      html += '</p>';
    });

    container.innerHTML = html;
}

function applyDriverOptionSupport(rows) {
    latestGpuSupportRows = Array.isArray(rows) ? rows : [];

    resetDriverOptionSupport();

    if (gpuSelectionFilterDisabled) {
      return;
    }

    if (!Array.isArray(rows) || rows.length === 0) {
      return;
    }

    var supportedAll = null;
    rows.forEach(function(row) {
      var fetchOkCount = Number((row && row.fetch_ok_count) || 0);
      if (fetchOkCount === 0) {
        return;
      }

      var list = Array.isArray(row.valid_drivers) ? row.valid_drivers : [];
      var set = new Set(list);
      if (supportedAll === null) {
        supportedAll = set;
      } else {
        supportedAll = new Set(Array.from(supportedAll).filter(function(v) { return set.has(v); }));
      }
    });

    // No resolved support data: keep current option state.
    if (supportedAll === null) {
      return;
    }

    var incompatibleAll = (supportedAll.size === 0);
    var hasOpenOnly = rows.some(function(row) {
      return String((row && row.kernel_module_support) || '').toLowerCase() === 'open-only';
    });
    var options = document.querySelectorAll('input[name="drv_version"]');
    options.forEach(function(option) {
      var mappedVersion = option.getAttribute('data-driver-version');
      if (!mappedVersion) {
        return;
      }

      var isSupported = incompatibleAll ? false : supportedAll.has(mappedVersion);
      if (hasOpenOnly && option.value !== 'latest_nos') {
        isSupported = false;
      }
      option.disabled = !isSupported;
      var parent = option.closest('p');
      if (parent) {
        parent.style.opacity = isSupported ? '1' : '0.5';
      }
    });

    var openOption = document.querySelector('input[name="drv_version"][value="latest_nos"]');
    if (openOption) {
      var openParent = openOption.closest('p');
      var proprietaryOnlyAll = rows.every(function(row) {
        return String((row && row.kernel_module_support) || '').toLowerCase() === 'proprietary-only';
      });
      var hasUnknown = rows.some(function(row) {
        return String((row && row.kernel_module_support) || '').toLowerCase() === 'unknown';
      });
      var hideOpen = proprietaryOnlyAll || hasUnknown;

      if (openParent) {
        openParent.style.display = hideOpen ? 'none' : '';
      }

      if (hideOpen) {
        openOption.disabled = true;
      }
    }

    var selected = document.querySelector('input[name="drv_version"]:checked');
    if (selected && selected.disabled) {
      var firstEnabled = document.querySelector('input[name="drv_version"]:not(:disabled)');
      if (firstEnabled) {
        firstEnabled.checked = true;
      }
    }
}

function loadGpuSupport() {
    var container = document.getElementById('gpu-support-content');
    if (!container) {
      return;
    }

    var url = '/plugins/nvidia-driver/include/gpu-support.php?_=' + Date.now();

    fetch(url, { cache: 'no-store' })
      .then(function(response) {
        if (!response.ok) {
          throw new Error('HTTP ' + response.status);
        }
        return response.json();
      })
      .then(function(data) {
        var rows = (data && data.rows) ? data.rows : [];
        renderGpuSupportRows(rows);
        applyDriverOptionSupport(rows);
      })
      .catch(function(err) {
        container.innerHTML = '<p><b style="color:tomato">GPU 兼容性数据加载失败。</b><br/><i>' + escapeHtml(err.message || '未知错误') + '</i></p>';
      });
}

document.addEventListener('DOMContentLoaded', loadGpuSupport);
document.addEventListener('DOMContentLoaded', updateGpuFilterButton);
</script>

